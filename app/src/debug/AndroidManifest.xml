<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the D0+D1 NaviHelper spike screen, reachable by adb (see README), not from the launcher. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".SpikeActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- Debug only: let `adb shell am broadcast` (shell uid, no Gleo permission) reach the Gleo handler for checks. -->
        <receiver android:name=".gleo.GleoReceiver" tools:node="merge" tools:remove="android:permission" />
        <!-- distractionOptimized is declared in src/main (all builds — contest decision, see the comment there). -->
    </application>
</manifest>
